# ================================================================
# RainCloud™ VPS Management — production configuration
# Fill TOKEN / ADMIN_ID / OWNER_ID before starting the bot.
# ================================================================

# Discord
TOKEN=
ADMIN_ID=1493564911039811725

DATABASE_FILE=vps_bot.db
LOG_FILE=vps_bot.log

BOT_STATUS_NAME=RGNODES™ VPS
PREFIX=-

VPS_HOSTNAME_PREFIX=rgnodes

DEFAULT_RAM=4G
DEFAULT_CPU=1
DEFAULT_DISK=10G

DEFAULT_LOCATION=SG
SERVER_LIMIT=1
TOTAL_RUNNING_LIMIT=50

ADMIN_BYPASS_LIMITS=true

STATUS_INTERVAL=45
DOCKER_TIMEOUT=120
ACCESS_TIMEOUT=120
DEPLOY_TIMEOUT=600
IMAGE_PULL_TIMEOUT=300

ENABLE_HARD_DISK_QUOTA=false
QUOTA_FALLBACK=true
DOCKER_FEATURE_FALLBACK=true
DOCKER_RETRIES=2

STATUS_CONCURRENCY=5
MEMORY_RESERVATION_PERCENT=75
DISABLE_CONTAINER_SWAP=true

HOST_TOTAL_RAM=64G
HOST_TOTAL_CPU=10
HOST_TOTAL_DISK=10T

MAX_PORTS_PER_VPS=10
PORT_RANGE_START=20000
PORT_RANGE_END=40000

PORT_SUPERVISOR_INTERVAL=20
PUBLIC_IP_REFRESH=300
REAL_LOCATION_REFRESH=900
IPV4_MODE=shared
REQUIRE_REAL_PUBLIC_IPV4=true
IPV4_REFRESH=300
# Optional storage quota / Docker compatibility
ENABLE_HARD_DISK_QUOTA=false
QUOTA_FALLBACK=true
DOCKER_FEATURE_FALLBACK=true
INTERACTION_LOG_UNKNOWN_AS_DEBUG=true
